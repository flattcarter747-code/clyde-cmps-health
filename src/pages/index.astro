---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Stripes from '../components/Stripes.astro';
import survey from '../data/survey.json';

const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);

const pct = (id: string, label: string) => {
  const q = survey.questions.find((q) => q.id === id)!;
  const r = q.results.find((r) => r.label === label)!;
  return Math.round((r.count / survey.total) * 100);
};
---
<BaseLayout description="Know Your Health, Clyde: plain-language info on 9 common health topics, local help near Clyde and Abilene, and our community survey results.">
  <section class="hero on-dark" aria-labelledby="hero-title">
    <Stripes variant="corner" />
    <div class="wrap">
      <div>
        <p class="eyebrow" style="color:var(--gold)">Clyde High School CmPS · 2026–27</p>
        <h1 id="hero-title">Know your health, <span class="script">Clyde</span></h1>
        <p class="lead">
          We're the Clyde High Community Problem Solving team. Many of us have watched family members
          deal with high blood pressure, cancer, heart attacks, and waiting for a transplant. We built this
          site so every family in Clyde can learn the basics, ask better questions, and find help close to home.
        </p>
        <div class="hero-actions">
          <a class="btn btn--gold" href="#topics">Explore 9 health topics <Icon name="arrow-right" size={20} /></a>
          <a class="btn btn--ghost-light" href="/resources/">Get help near Clyde</a>
        </div>
      </div>
      <div class="logo-stage" id="logo-stage">
        <div class="plus-field" aria-hidden="true">
          {Array.from({ length: 9 }, (_, i) => <span class={`plus p${i + 1}`}>+</span>)}
        </div>
        <div class="logo-tilt">
          <div class="logo-float">
            <div class="hero-logo">
              <picture>
                <source type="image/webp" srcset="/images/health-care-logo-500.webp 500w, /images/health-care-logo-672.webp 672w" sizes="(min-width: 860px) 36vw, 90vw" />
                <img
                  src="/images/health-care-logo-500.png"
                  srcset="/images/health-care-logo-500.png 500w, /images/health-care-logo-672.png 672w"
                  sizes="(min-width: 860px) 36vw, 90vw"
                  alt="Health Care logo: the word health in blue script above CARE, where the C is a stethoscope, the A is a syringe, and a red plus sign follows."
                  width="672" height="330" fetchpriority="high" decoding="async"
                />
              </picture>
              <span class="logo-shine" aria-hidden="true"></span>
            </div>
          </div>
        </div>
        <svg class="ekg" viewBox="0 0 600 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path class="ekg-base" d="M0 50 H170 L190 50 L205 20 L222 74 L240 6 L258 66 L272 50 H600" />
          <path class="ekg-line" pathLength="100" d="M0 50 H170 L190 50 L205 20 L222 74 L240 6 L258 66 L272 50 H600" />
        </svg>
      </div>
    </div>
  </section>

  <section class="stats section" aria-labelledby="stats-title">
    <div class="wrap">
      <div class="stats-head">
        <p class="eyebrow">What Clyde told us</p>
        <h2 id="stats-title">We asked {survey.total} neighbors. Here's what they said.</h2>
      </div>
      <ul class="stats-grid">
        <li class="stat">
          <span class="stat-num">{pct('community-educated', 'No')}%</span>
          <span class="stat-label">said our community <strong>isn't</strong> educated on health concerns</span>
        </li>
        <li class="stat">
          <span class="stat-num">{pct('would-benefit', 'Yes')}%</span>
          <span class="stat-label">said more health education <strong>would help</strong> our community</span>
        </li>
        <li class="stat">
          <span class="stat-num">{pct('checkup', 'More than a year ago')}%</span>
          <span class="stat-label">hadn't had a wellness checkup in <strong>more than a year</strong></span>
        </li>
      </ul>
      <p style="margin-top:1.25rem"><a href="/survey/" style="font-weight:700">See all our survey results</a></p>
    </div>
  </section>

  <section id="topics" class="section" aria-labelledby="topics-title">
    <div class="wrap">
      <p class="eyebrow">Pick a topic</p>
      <h2 id="topics-title">9 things worth knowing</h2>
      <p class="lead" style="max-width:40rem">These are the topics our community asked about most. Each one is short, written in plain English, and links to trusted health sites.</p>
      <ul class="topic-grid">
        {topics.map((t) => (
          <li>
            <a class="topic-card" href={`/topics/${t.id}/`}>
              <span class="topic-icon"><Icon name={t.data.icon} size={28} /></span>
              <div>
                <h3>{t.data.title}</h3>
                <p>{t.data.hook}</p>
                <span class="more" aria-hidden="true">Learn more <Icon name="arrow-right" size={16} /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Stripes />

  <section class="section section--paper" aria-labelledby="help-title">
    <div class="wrap">
      <div class="help-callout">
        <Stripes variant="corner" />
        <p class="eyebrow">Close to home</p>
        <h2 id="help-title">Get help near <span class="script">Clyde</span></h2>
        <ul class="help-list">
          <li><strong>911</strong>Emergency? Call <a href="tel:911">911</a> right away.</li>
          <li><strong>988</strong>Struggling or in crisis? <a href="tel:988">Call</a> or <a href="sms:988">text</a> 988, any time.</li>
          <li><strong>Local help</strong>Blood donation, organ donor sign-up, CPR classes, and clinics.</li>
        </ul>
        <a class="btn btn--black" href="/resources/">See local resources <Icon name="arrow-right" size={20} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Home page always opens at the top: on refresh, on the Home/logo link, and on Back.
  // (A link to a section, like /#topics, still jumps to that section.)
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  const toTop = () => { if (!location.hash) window.scrollTo(0, 0); };
  toTop();
  window.addEventListener('load', toTop);
  window.addEventListener('pageshow', (e) => { if (e.persisted) toTop(); });
  // Already on the home page? A Home/logo click just goes straight to the top.
  document.addEventListener('click', (e) => {
    const link = e.target.closest && e.target.closest('a[href="/"]');
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    e.preventDefault();
    history.replaceState(null, '', '/');
    window.scrollTo(0, 0);
    document.getElementById('main')?.focus({ preventScroll: true });
  });
</script>

<script>
  // Health Care logo: tilt toward the mouse (desktop only, and only if motion is OK).
  const stage = document.getElementById('logo-stage');
  const tilt = stage?.querySelector<HTMLElement>('.logo-tilt');
  const fine = window.matchMedia('(pointer: fine)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (stage && tilt && fine && !calm) {
    let frame = 0;
    stage.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = stage.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        tilt.style.setProperty('--ry', `${(x * 14).toFixed(2)}deg`);
        tilt.style.setProperty('--rx', `${(-y * 12).toFixed(2)}deg`);
      });
    });
    stage.addEventListener('pointerleave', () => {
      cancelAnimationFrame(frame);
      tilt.style.setProperty('--ry', '0deg');
      tilt.style.setProperty('--rx', '0deg');
    });
  }
</script>
