---
import Icon from './Icon.astro';
import Stripes from './Stripes.astro';
import site from '../data/site.json';
// TODO_INSTAGRAM_URL: put our real Instagram link in src/data/site.json ("instagramUrl").
const hasInstagram = site.instagramUrl.startsWith('http');
---
<footer class="site-footer on-dark">
  <div class="wrap">
    <p class="disclaimer" role="note">
      <strong>Please note:</strong> This site is for education only and is not medical advice. Talk to your doctor about your health. In an emergency, call 911.
    </p>
    <div class="footer-grid">
      <div>
        <a class="logo" href="/">
          <span class="script">Clyde</span>
          <span class="logo-text">Know Your Health<small>CmPS '26–'27</small></span>
        </a>
        <p style="margin-top:0.75rem;max-width:26rem">Plain-language health info for Clyde, Abilene, and Callahan County, made by students who care about this town.</p>
      </div>
      <div>
        <h2>Explore</h2>
        <ul>
          <li><a href="/#topics">Health topics</a></li>
          <li><a href="/survey/">Our survey results</a></li>
          <li><a href="/events/">Events</a></li>
          <li><a href="/about/">About our team</a></li>
        </ul>
      </div>
      <div>
        <h2>Get help</h2>
        <ul>
          <li><a href="tel:911"><Icon name="phone" size={18} />Emergency: call 911</a></li>
          <li><a href="tel:988"><Icon name="phone" size={18} />Crisis line: call or text 988</a></li>
          <li><a href="/resources/"><Icon name="map-pin" size={18} />Help near Clyde</a></li>
          <li>
            <a href={hasInstagram ? site.instagramUrl : '#'} rel="noopener" aria-disabled={hasInstagram ? undefined : 'true'}>
              <Icon name="instagram" size={18} />Follow us on Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-credit">
      <picture class="cisd-badge">
        <source type="image/webp" srcset="/images/clyde-cisd-logo-240.webp 240w, /images/clyde-cisd-logo-480.webp 480w" sizes="88px" />
        <img src="/images/clyde-cisd-logo-240.png" alt="Clyde CISD Bulldogs logo" width="240" height="213" loading="lazy" decoding="async" />
      </picture>
      <p>A Clyde High School Community Problem Solving project. © {new Date().getFullYear()} Clyde High School CmPS.</p>
    </div>
  </div>
  <Stripes variant="corner" class="footer-stripes" />
</footer>

<style>
  .footer-stripes { right: -90px; bottom: -110px; width: 240px; opacity: 0.35; }
  .footer-credit { display: flex; align-items: center; gap: 1rem; position: relative; z-index: 1; }
  .footer-credit p { margin: 0; }
  .cisd-badge { flex: none; background: #fff; border-radius: 12px; padding: 6px; border: 2px solid var(--gold); }
  .cisd-badge img { width: 76px; height: auto; }
</style>
