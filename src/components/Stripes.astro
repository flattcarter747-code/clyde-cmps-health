---
// Diagonal "brush stroke" stripes, inspired by our booth banner and Instagram poster.
// Purely decorative. variant: "divider" (thin band between sections) or "corner" (big accent).
interface Props { variant?: 'divider' | 'corner'; flip?: boolean; class?: string }
const { variant = 'divider', flip = false, class: className } = Astro.props;
---
{variant === 'divider' ? (
  <div class:list={['stripes-divider', { flip }, className]} aria-hidden="true">
    <svg viewBox="0 0 1200 60" preserveAspectRatio="none" focusable="false">
      <g stroke-linecap="round" stroke-width="10">
        <line x1="-20" y1="52" x2="260" y2="8" stroke="#111" />
        <line x1="120" y1="56" x2="420" y2="10" stroke="#C5B358" />
        <line x1="330" y1="50" x2="560" y2="14" stroke="#fff" />
        <line x1="520" y1="54" x2="820" y2="6" stroke="#111" />
        <line x1="700" y1="52" x2="930" y2="16" stroke="#C5B358" />
        <line x1="880" y1="50" x2="1110" y2="12" stroke="#fff" />
        <line x1="1000" y1="56" x2="1240" y2="8" stroke="#111" />
      </g>
      <circle cx="600" cy="48" r="5" fill="#111" />
      <circle cx="1150" cy="44" r="4" fill="#C5B358" />
    </svg>
  </div>
) : (
  <svg class:list={['stripes-corner', { flip }, className]} viewBox="0 0 300 300" aria-hidden="true" focusable="false">
    <g stroke-linecap="round">
      <line x1="80" y1="-20" x2="320" y2="220" stroke="#111" stroke-width="22" />
      <line x1="140" y1="-30" x2="330" y2="160" stroke="#111" stroke-width="12" />
      <line x1="40" y1="20" x2="280" y2="260" stroke="#C5B358" stroke-width="16" />
      <line x1="190" y1="-20" x2="320" y2="110" stroke="#fff" stroke-width="10" />
      <line x1="10" y1="80" x2="140" y2="210" stroke="#111" stroke-width="8" />
    </g>
    <circle cx="245" cy="35" r="7" fill="#fff" />
    <circle cx="60" cy="45" r="5" fill="#111" />
  </svg>
)}
